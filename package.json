{
	"name": "detour",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"test": "vitest",
		"cf-typegen": "wrangler types",
		"format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"test/integration/**/*.mjs\" \"docs/live-testing.md\" \"docs/peer-project-review.md\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"test/integration/**/*.mjs\" \"docs/live-testing.md\" \"docs/peer-project-review.md\"",
		"lint": "eslint src test",
		"typecheck": "tsc --noEmit",
		"check": "node --check test/integration/live-worker.mjs && npm run format:check && npm run lint && npm run typecheck && npm test -- --run",
		"fix": "npm run format && npm run lint -- --fix && npm run format:check",
		"test:live": "node test/integration/live-worker.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.0.0",
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"globals": "^17.13.0",
		"prettier": "^3.9.9",
		"typescript": "^5.5.2",
		"typescript-eslint": "^8.71.1",
		"vitest": "~4.1.0",
		"wrangler": "^4.149.0"
	}
}
